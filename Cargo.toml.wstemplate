[package]
authors = ["https://github.com/jowharshamshiri"]
description = "Verifies signed release manifests and registry charters against baked root keys"
edition = "2021"
rust-version = "1.80"
license = "MIT"
name = "mg-srel"
readme = "README.md"
repository = "https://github.com/jowharshamshiri/mg-srel"
keywords = ["signature", "ed25519", "minisign", "release", "manifest"]
categories = ["cryptography"]
include = ["src/**/*.rs", "README.md", "LICENSE"]
version = "{{ project.version }}"

[dependencies]
# Raw ed25519 over exact bytes: certificates, manifest signatures and charter
# signatures are not minisign-prehashed, so the platform verifiers stay simple.
ed25519-dalek = { version = "2", default-features = false, features = ["std"] }
# Minisign signatures over artifacts (`.minisig`), whose trusted comment is
# signed too. Zero dependencies of its own.
minisign-verify = "0.2"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "1.0"

[dev-dependencies]
# Registry folders for the stored-charter tests.
tempfile = "3.10"
